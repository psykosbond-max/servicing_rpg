    const canvas = canvasRef.current;
    if (!canvas) return;
    
    const rect = canvas.getBoundingClientRect();
    const mouseX = (e.clientX - rect.left) / TILE_SIZE;
    const mouseY = (e.clientY - rect.top) / TILE_SIZE;

