  const checkInteractions = () => {
    // Use ref for most current position (state may be stale in closure)
    const { x, y } = playerPositionRef.current;
    const currentRoom = rooms[gameState.currentRoom];
    
    currentRoom.npcs.forEach(npc => {
      const distance = Math.sqrt(Math.pow(x - npc.x, 2) + Math.pow(y - npc.y, 2));
      if (distance < 2.5) {
        talkToNPC(npc.name);
      }
    });
  };

