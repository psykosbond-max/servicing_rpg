      // Horizontal wood planks
      for (let i = 0; i < ROOM_HEIGHT * TILE_SIZE; i += 40) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(ROOM_WIDTH * TILE_SIZE, i);
        ctx.stroke();
        
        // Vertical seams at random intervals
        const seams = [100, 280, 420, 580, 720];
        seams.forEach(x => {
          ctx.beginPath();
          ctx.moveTo(x, i);
          ctx.lineTo(x, i + 40);
          ctx.stroke();
        });
      }
      
      // Wood grain effect
      ctx.strokeStyle = 'rgba(139, 92, 112, 0.08)';
      ctx.lineWidth = 1;
      for (let i = 0; i < ROOM_HEIGHT * TILE_SIZE; i += 40) {
        for (let j = 0; j < 3; j++) {
          ctx.beginPath();
          ctx.moveTo(0, i + 10 + j * 10);
          ctx.lineTo(ROOM_WIDTH * TILE_SIZE, i + 10 + j * 10);
          ctx.stroke();
        }
      }
    }

    // Creative Department - Checkered wooden floor
    if (gameState.currentRoom === 'creative') {
      const squareSize = 50;
      
      // Draw checkered pattern
      for (let x = 0; x < ROOM_WIDTH; x++) {
        for (let y = 0; y < ROOM_HEIGHT; y++) {
          const squareX = x * squareSize;
          const squareY = y * squareSize;
          
          // Alternate light and dark wood squares
          if ((x + y) % 2 === 0) {
            // Light wood square
            ctx.fillStyle = 'rgba(245, 158, 11, 0.15)';
            ctx.fillRect(squareX, squareY, squareSize, squareSize);
          } else {
            // Dark wood square
            ctx.fillStyle = 'rgba(180, 83, 9, 0.2)';
            ctx.fillRect(squareX, squareY, squareSize, squareSize);
          }
        }
      }
      
      // Wood grain lines on each square
      ctx.strokeStyle = 'rgba(120, 53, 15, 0.15)';
      ctx.lineWidth = 1;
      
      for (let x = 0; x < ROOM_WIDTH; x++) {
        for (let y = 0; y < ROOM_HEIGHT; y++) {
          const squareX = x * squareSize;
          const squareY = y * squareSize;
          
          // Horizontal wood grain
          for (let i = 0; i < 5; i++) {
            const offset = (i * 10) + 5;
            ctx.beginPath();
            ctx.moveTo(squareX, squareY + offset);
            ctx.lineTo(squareX + squareSize, squareY + offset);
            ctx.stroke();
          }
        }
      }
      
      // Square borders for definition
      ctx.strokeStyle = 'rgba(120, 53, 15, 0.25)';
      ctx.lineWidth = 2;
      
      for (let i = 0; i <= ROOM_WIDTH * squareSize; i += squareSize) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, ROOM_HEIGHT * squareSize);
        ctx.stroke();
      }
      for (let i = 0; i <= ROOM_HEIGHT * squareSize; i += squareSize) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(ROOM_WIDTH * squareSize, i);
        ctx.stroke();
      }
      
      // Add subtle wood knots randomly
      ctx.fillStyle = 'rgba(120, 53, 15, 0.2)';
      const knots = [
        { x: 125, y: 175 }, { x: 325, y: 275 }, { x: 575, y: 125 },
        { x: 225, y: 425 }, { x: 475, y: 325 }, { x: 675, y: 475 },
        { x: 75, y: 525 }, { x: 525, y: 75 }, { x: 375, y: 575 }
      ];
      
      knots.forEach(knot => {
        ctx.beginPath();
        ctx.arc(knot.x, knot.y, 4, 0, Math.PI * 2);
        ctx.fill();
        
        // Knot rings
        ctx.strokeStyle = 'rgba(120, 53, 15, 0.15)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(knot.x, knot.y, 6, 0, Math.PI * 2);
        ctx.stroke();
      });
    }

    // Servicing - Professional carpet texture
    if (gameState.currentRoom === 'servicing') {
      // Carpet fiber texture
      ctx.fillStyle = 'rgba(6, 182, 212, 0.08)';
      for (let y = 0; y < ROOM_HEIGHT * TILE_SIZE; y += 4) {
        for (let x = 0; x < ROOM_WIDTH * TILE_SIZE; x += 8) {
          const offset = (y / 4) % 2 === 0 ? 0 : 4;
          ctx.fillRect(x + offset, y, 6, 2);
        }
      }
      
      // Subtle carpet pattern - diamond shapes
      ctx.strokeStyle = 'rgba(6, 182, 212, 0.15)';
      ctx.lineWidth = 1;
      const diamondSize = 60;
      for (let y = 0; y < ROOM_HEIGHT * TILE_SIZE; y += diamondSize) {
        for (let x = 0; x < ROOM_WIDTH * TILE_SIZE; x += diamondSize) {
          ctx.beginPath();
          ctx.moveTo(x + diamondSize / 2, y);
          ctx.lineTo(x + diamondSize, y + diamondSize / 2);
          ctx.lineTo(x + diamondSize / 2, y + diamondSize);
          ctx.lineTo(x, y + diamondSize / 2);
          ctx.closePath();
          ctx.stroke();
        }
      }
    }

    // Production Studio - Industrial concrete texture
    if (gameState.currentRoom === 'studio') {
      // Concrete texture - subtle irregular marks
      ctx.fillStyle = 'rgba(99, 102, 241, 0.06)';
      for (let i = 0; i < 150; i++) {
        const rx = Math.random() * ROOM_WIDTH * TILE_SIZE;
        const ry = Math.random() * ROOM_HEIGHT * TILE_SIZE;
        const w = Math.random() * 20 + 10;
        const h = Math.random() * 3 + 1;
        ctx.fillRect(rx, ry, w, h);
      }
      
      // Concrete expansion joints
      ctx.strokeStyle = 'rgba(99, 102, 241, 0.12)';
      ctx.lineWidth = 3;
      
      // Large square sections
      const sectionSize = 150;
      for (let i = 0; i <= ROOM_WIDTH * TILE_SIZE; i += sectionSize) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, ROOM_HEIGHT * TILE_SIZE);
        ctx.stroke();
      }
      for (let i = 0; i <= ROOM_HEIGHT * TILE_SIZE; i += sectionSize) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(ROOM_WIDTH * TILE_SIZE, i);
        ctx.stroke();
      }
      
      // Concrete speckles
      ctx.fillStyle = 'rgba(99, 102, 241, 0.1)';
      for (let i = 0; i < 100; i++) {
        const rx = Math.random() * ROOM_WIDTH * TILE_SIZE;
        const ry = Math.random() * ROOM_HEIGHT * TILE_SIZE;
        const size = Math.random() * 2 + 1;
        ctx.fillRect(rx, ry, size, size);
      }
    }

    // Textured tile floor for break room
    if (gameState.currentRoom === 'breakroom') {
      const tileSize = 50;
      
      // Tile grid lines
      ctx.strokeStyle = 'rgba(219, 39, 119, 0.15)';
      ctx.lineWidth = 2;
      
      // Vertical lines
      for (let i = 0; i <= ROOM_WIDTH * TILE_SIZE; i += tileSize) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, ROOM_HEIGHT * TILE_SIZE);
        ctx.stroke();
      }
      
      // Horizontal lines
      for (let i = 0; i <= ROOM_HEIGHT * TILE_SIZE; i += tileSize) {
        ctx.beginPath();
        ctx.moveTo(0, i);
        ctx.lineTo(ROOM_WIDTH * TILE_SIZE, i);
        ctx.stroke();
      }
      
      // Add subtle diagonal texture in each tile
      ctx.strokeStyle = 'rgba(219, 39, 119, 0.08)';
      ctx.lineWidth = 1;
      
      for (let x = 0; x < ROOM_WIDTH; x++) {
        for (let y = 0; y < ROOM_HEIGHT; y++) {
          const tileX = x * tileSize;
          const tileY = y * tileSize;
          
          // Diagonal lines for texture
          ctx.beginPath();
          ctx.moveTo(tileX, tileY);
          ctx.lineTo(tileX + tileSize, tileY + tileSize);
          ctx.stroke();
          
          // Alternate diagonal pattern (checkerboard effect)
          if ((x + y) % 2 === 0) {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.03)';
            ctx.fillRect(tileX, tileY, tileSize, tileSize);
          }
        }
      }
      
      // Add subtle speckles for ceramic tile effect
      ctx.fillStyle = 'rgba(219, 39, 119, 0.12)';
      for (let i = 0; i < 80; i++) {
        const rx = Math.random() * ROOM_WIDTH * TILE_SIZE;
        const ry = Math.random() * ROOM_HEIGHT * TILE_SIZE;
        const size = Math.random() * 2 + 1;
        ctx.fillRect(rx, ry, size, size);
      }
    }

    // Draw room border
    ctx.strokeStyle = currentRoom.accentColor;
    ctx.lineWidth = 6;
    ctx.strokeRect(0, 0, ROOM_WIDTH * TILE_SIZE, ROOM_HEIGHT * TILE_SIZE);

    // Draw room name - BIGGER AND CLEARER
    // Position banner lower in studio room to avoid door overlap
    const bannerY = gameState.currentRoom === 'studio' ? 80 : 0;
    const bannerHeight = 80;
    const bannerWidth = ROOM_WIDTH * TILE_SIZE;
    
    ctx.fillStyle = currentRoom.accentColor;
    ctx.fillRect(0, bannerY, bannerWidth, bannerHeight);
    
    // Inner glow
    ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
    ctx.fillRect(0, bannerY, bannerWidth, bannerHeight);
    
    // Border lines
    ctx.strokeStyle = 'rgba(0, 0, 0, 0.3)';
    ctx.lineWidth = 4;
    ctx.strokeRect(0, bannerY, bannerWidth, bannerHeight);
    
    // Room name text - EXTRA LARGE
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 32px "Press Start 2P"';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    
    // Text with outline for maximum visibility
    ctx.strokeStyle = '#000000';
    ctx.lineWidth = 6;
    ctx.strokeText(currentRoom.name, (ROOM_WIDTH * TILE_SIZE) / 2, bannerY + bannerHeight / 2);
    ctx.fillText(currentRoom.name, (ROOM_WIDTH * TILE_SIZE) / 2, bannerY + bannerHeight / 2);

    // Draw furniture
    currentRoom.furniture.forEach(item => {
      drawFurniture(ctx, item);
    });

    // Draw exits/doors
    currentRoom.exits.forEach(exit => {
      drawExit(ctx, exit);
    });

    // Draw NPCs
    currentRoom.npcs.forEach(npc => {
      const key = `${gameState.currentRoom}-${npc.name}`;
      const dynamicPos = npcPositions[key];
      
      // Use dynamic position if available, otherwise use default
      if (dynamicPos && npc.name !== 'Sarah') {
        const dynamicNpc = { ...npc, x: dynamicPos.x, y: dynamicPos.y };
        drawNPC(ctx, dynamicNpc);
      } else {
        drawNPC(ctx, npc);
      }
    });

    // Draw player
    drawPlayer(ctx, gameState.playerPosition, gameState.playerGender);

  }, [gameState.gameStarted, gameState.characterSelected, gameState.currentRoom, gameState.playerPosition, gameState.playerGender, hoveredNPC, npcPositions]);

  const drawFurniture = (ctx, item) => {
    const x = item.x * TILE_SIZE;
    const y = item.y * TILE_SIZE;

    ctx.save();

    switch (item.type) {
      case 'desk':
        // Desktop
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        
        // Wood grain effect
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.1)';
        ctx.lineWidth = 2;
        for (let i = 0; i < 3; i++) {
          ctx.beginPath();
          ctx.moveTo(x, y + 10 + i * 10);
          ctx.lineTo(x + item.width * TILE_SIZE, y + 10 + i * 10);
          ctx.stroke();
        }
        
        // Laptop
        ctx.fillStyle = '#1f2937';
        ctx.fillRect(x + 15, y + 10, 30, 20);
        
        // Desk lamp
        ctx.fillStyle = '#fbbf24';
        ctx.beginPath();
        ctx.arc(x + item.width * TILE_SIZE - 15, y + 15, 8, 0, Math.PI * 2);
        ctx.fill();
        break;

      case 'chair':
        ctx.fillStyle = item.color;
        // Seat
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        // Backrest
        ctx.fillRect(x + 5, y - 15, item.width * TILE_SIZE - 10, 18);
        break;

      case 'sofa':
        // Modern detailed sofa
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        
        // Cushion segments
        const cushionWidth = (item.width * TILE_SIZE) / 2;
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x + cushionWidth, y);
        ctx.lineTo(x + cushionWidth, y + item.height * TILE_SIZE);
        ctx.stroke();
        
        // Tufted buttons
        ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
        for (let i = 0; i < 2; i++) {
          for (let j = 0; j < 1; j++) {
            ctx.beginPath();
            ctx.arc(x + 20 + i * 60, y + 20, 3, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        
        // Armrests
        ctx.fillStyle = item.color;
        ctx.fillRect(x - 8, y - 5, 8, item.height * TILE_SIZE + 10);
        ctx.fillRect(x + item.width * TILE_SIZE, y - 5, 8, item.height * TILE_SIZE + 10);
        
        // Throw pillows
        ctx.fillStyle = '#fbbf24';
        ctx.fillRect(x + 10, y + 5, 18, 18);
        ctx.fillStyle = '#ec4899';
        ctx.fillRect(x + item.width * TILE_SIZE - 28, y + 5, 18, 18);
        break;

      case 'table':
        if (item.round) {
          // Round table with detail
          ctx.fillStyle = item.color;
          ctx.beginPath();
          ctx.ellipse(
            x + (item.width * TILE_SIZE) / 2,
            y + (item.height * TILE_SIZE) / 2,
            (item.width * TILE_SIZE) / 2,
            (item.height * TILE_SIZE) / 2,
            0, 0, Math.PI * 2
          );
          ctx.fill();
          
          // Table edge highlight
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
          ctx.lineWidth = 3;
          ctx.stroke();
          
          // Wood grain center
          ctx.fillStyle = 'rgba(139, 92, 112, 0.2)';
          ctx.beginPath();
          ctx.ellipse(
            x + (item.width * TILE_SIZE) / 2,
            y + (item.height * TILE_SIZE) / 2,
            (item.width * TILE_SIZE) / 3,
            (item.height * TILE_SIZE) / 3,
            0, 0, Math.PI * 2
          );
          ctx.fill();
          
          // Decorative items on table
          // Coffee cup
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(x + 20, y + 25, 6, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#6b4423';
          ctx.beginPath();
          ctx.arc(x + 20, y + 25, 4, 0, Math.PI * 2);
          ctx.fill();
          
          // Magazine
          ctx.fillStyle = '#3b82f6';
          ctx.fillRect(x + 35, y + 30, 20, 15);
        } else {
          ctx.fillStyle = item.color;
          ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        }
        break;

      case 'reception':
        // Modern reception counter
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        
        // Counter top shine
        ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
        ctx.fillRect(x, y, item.width * TILE_SIZE, 10);
        
        // Front panel design
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
        ctx.lineWidth = 2;
        ctx.strokeRect(x + 5, y + 15, item.width * TILE_SIZE - 10, item.height * TILE_SIZE - 20);
        
        // Computer monitor
        ctx.fillStyle = '#1f2937';
        ctx.fillRect(x + 20, y + 15, 28, 22);
        ctx.fillStyle = '#3b82f6';
        ctx.fillRect(x + 22, y + 17, 24, 16);
        
        // Keyboard
        ctx.fillStyle = '#374151';
        ctx.fillRect(x + 20, y + 40, 28, 10);
        
        // Phone
        ctx.fillStyle = '#6b7280';
        ctx.fillRect(x + item.width * TILE_SIZE - 35, y + 20, 15, 20);
        
        // Decorative plant on desk
        ctx.fillStyle = '#10b981';
        ctx.beginPath();
        ctx.arc(x + item.width * TILE_SIZE - 15, y + 25, 6, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#92400e';
        ctx.fillRect(x + item.width * TILE_SIZE - 20, y + 30, 10, 8);
        break;

      case 'plant':
        // Pot
        ctx.fillStyle = '#92400e';
        ctx.fillRect(x, y + item.size * 20, item.size * TILE_SIZE, item.size * 20);
        // Leaves
        ctx.fillStyle = item.color;
        for (let i = 0; i < 6; i++) {
          const angle = (i * Math.PI * 2) / 6;
          ctx.beginPath();
          ctx.ellipse(
            x + (item.size * TILE_SIZE) / 2 + Math.cos(angle) * 15,
            y + (item.size * TILE_SIZE) / 2 + Math.sin(angle) * 15,
            12, 8, angle, 0, Math.PI * 2
          );
          ctx.fill();
        }
        break;

      case 'whiteboard':
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        ctx.strokeStyle = '#374151';
        ctx.lineWidth = 3;
        ctx.strokeRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        break;

      case 'bookshelf':
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        // Books
        const colors = ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'];
        for (let i = 0; i < 12; i++) {
          ctx.fillStyle = colors[i % colors.length];
          ctx.fillRect(
            x + 5 + (i % 4) * 10,
            y + 10 + Math.floor(i / 4) * 30,
            8, 25
          );
        }
        break;

      case 'filing':
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        // Drawers
        for (let i = 0; i < 3; i++) {
          ctx.strokeStyle = '#0e7490';
          ctx.lineWidth = 2;
          ctx.strokeRect(x + 5, y + 5 + i * 15, item.width * TILE_SIZE - 10, 12);
        }
        break;

      case 'equipment':
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        // Lens
        ctx.fillStyle = '#3b82f6';
        ctx.beginPath();
        ctx.arc(x + (item.width * TILE_SIZE) / 2, y + (item.height * TILE_SIZE) / 2, 15, 0, Math.PI * 2);
        ctx.fill();
        break;

      case 'coffee':
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        // Button
        ctx.fillStyle = '#10b981';
        ctx.beginPath();
        ctx.arc(x + 25, y + 20, 5, 0, Math.PI * 2);
        ctx.fill();
        break;

      case 'fridge':
        ctx.fillStyle = item.color;
        ctx.fillRect(x, y, item.width * TILE_SIZE, item.height * TILE_SIZE);
        // Handle
        ctx.fillStyle = '#9ca3af';
        ctx.fillRect(x + item.width * TILE_SIZE - 8, y + 25, 5, 15);
        break;
    }

    ctx.restore();
  };

  const drawExit = (ctx, exit) => {
    const x = exit.x * TILE_SIZE;
    const y = exit.y * TILE_SIZE;
    const width = exit.width * TILE_SIZE;
    const height = exit.height * TILE_SIZE;

    // Door/exit area
    ctx.fillStyle = exit.color || '#10b981';
    ctx.globalAlpha = 0.7;
    ctx.fillRect(x, y, width, height);
    ctx.globalAlpha = 1;

    // Border
    ctx.strokeStyle = exit.color || '#10b981';
    ctx.lineWidth = 4;
    ctx.strokeRect(x, y, width, height);

    // Label - RETRO FONT, dynamically sized
    ctx.fillStyle = '#ffffff';
    
    // Determine if door is vertical or horizontal
    const isVertical = height > width;
    
    // Use smaller font for vertical doors
    const fontSize = isVertical ? 10 : 14;
    ctx.font = `bold ${fontSize}px "Press Start 2P"`;
    ctx.textAlign = 'center';
    
    // Multi-line text for better readability
    const lines = exit.label.split(' ');
    const lineHeight = fontSize + 2;
    const startY = y + height / 2 - (lines.length - 1) * lineHeight / 2;
    
    lines.forEach((line, i) => {
      ctx.fillText(line, x + width / 2, startY + i * lineHeight);
    });
  };

  const drawNPC = (ctx, npc) => {
    const x = npc.x * TILE_SIZE;
    const y = npc.y * TILE_SIZE;
    const size = 42;

    ctx.save();

    // Shadow
    ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
    ctx.beginPath();
    ctx.ellipse(x, y + size + 8, size / 2, size / 7, 0, 0, Math.PI * 2);
    ctx.fill();

    // Draw specific characters
    if (npc.name === 'Sarah') {
      // Receptionist - Modern chic with rose blazer
      // Rose/mauve blazer
      ctx.fillStyle = '#f472b6';
      ctx.fillRect(x - 14, y + 14, 28, 22);
      
      // White silk blouse underneath
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.moveTo(x - 11, y + 16);
      ctx.lineTo(x + 11, y + 16);
      ctx.lineTo(x + 9, y + 30);
      ctx.lineTo(x - 9, y + 30);
      ctx.closePath();
      ctx.fill();
      
      // Blazer lapels
      ctx.fillStyle = '#ec4899';
      ctx.beginPath();
      ctx.moveTo(x, y + 16);
      ctx.lineTo(x - 12, y + 18);
      ctx.lineTo(x - 10, y + 26);
      ctx.lineTo(x, y + 22);
      ctx.closePath();
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(x, y + 16);
      ctx.lineTo(x + 12, y + 18);
      ctx.lineTo(x + 10, y + 26);
      ctx.lineTo(x, y + 22);
      ctx.closePath();
      ctx.fill();
      
      // Navy pencil skirt
      ctx.fillStyle = '#1e3a8a';
      ctx.fillRect(x - 12, y + 36, 24, 12);
      
      // Delicate gold necklace
      ctx.strokeStyle = '#fbbf24';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(x, y + 19, 7, 0.4, Math.PI - 0.4);
      ctx.stroke();
      
      // Gold pendant
      ctx.fillStyle = '#fbbf24';
      ctx.beginPath();
      ctx.arc(x, y + 22, 2.5, 0, Math.PI * 2);
      ctx.fill();
      
      // Head
      ctx.fillStyle = '#fce8d0';
      ctx.beginPath();
      ctx.arc(x, y, 14, 0, Math.PI * 2);
      ctx.fill();
      
      // Soft wavy hair - shoulder length
      ctx.fillStyle = '#8b6f47';
      ctx.beginPath();
      ctx.ellipse(x, y - 7, 14, 11, 0, Math.PI, Math.PI * 2);
      ctx.fill();
      
      // Soft waves on sides
      ctx.beginPath();
      ctx.moveTo(x - 14, y - 5);
      ctx.quadraticCurveTo(x - 16, y + 2, x - 13, y + 10);
      ctx.quadraticCurveTo(x - 11, y + 4, x - 12, y - 2);
      ctx.closePath();
      ctx.fill();
      
      ctx.beginPath();
      ctx.moveTo(x + 14, y - 5);
      ctx.quadraticCurveTo(x + 16, y + 2, x + 13, y + 10);
      ctx.quadraticCurveTo(x + 11, y + 4, x + 12, y - 2);
      ctx.closePath();
      ctx.fill();
      
      // Soft bangs
      ctx.beginPath();
      ctx.moveTo(x - 12, y - 7);
      ctx.quadraticCurveTo(x - 4, y - 9, x + 3, y - 6);
      ctx.quadraticCurveTo(x + 8, y - 8, x + 12, y - 7);
      ctx.lineTo(x + 12, y - 4);
      ctx.quadraticCurveTo(x, y - 6, x - 12, y - 4);
      ctx.closePath();
      ctx.fill();
      
      // Friendly eyes
      ctx.fillStyle = '#1a1410';
      ctx.beginPath();
      ctx.arc(x - 5, y + 1, 2.5, 0, Math.PI * 2);
      ctx.arc(x + 5, y + 1, 2.5, 0, Math.PI * 2);
      ctx.fill();
      
      // Eye highlights
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(x - 4, y, 1, 0, Math.PI * 2);
      ctx.arc(x + 6, y, 1, 0, Math.PI * 2);
      ctx.fill();
      
      // Natural smile
      ctx.strokeStyle = '#f472b6';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(x, y + 7, 5, 0, Math.PI);
      ctx.stroke();
      
      // Subtle blush
      ctx.fillStyle = 'rgba(244, 114, 182, 0.25)';
      ctx.beginPath();
      ctx.ellipse(x - 8, y + 4, 4, 3, 0, 0, Math.PI * 2);
      ctx.ellipse(x + 8, y + 4, 4, 3, 0, 0, Math.PI * 2);
      ctx.fill();
      
      // Small gold stud earrings
      ctx.fillStyle = '#fbbf24';
      ctx.beginPath();
      ctx.arc(x - 14, y + 2, 2, 0, Math.PI * 2);
      ctx.arc(x + 14, y + 2, 2, 0, Math.PI * 2);
      ctx.fill();
      
    } else if (npc.name === 'Mike') {
      // Creative Director - Casual Friday tech CEO style
      // Dark grey chinos
      ctx.fillStyle = '#4b5563';
      ctx.fillRect(x - 14, y + 34, 28, 14);
      
      // Heather blue button-up shirt (rolled sleeves)
      ctx.fillStyle = '#60a5fa';
      ctx.fillRect(x - 15, y + 14, 30, 22);
      
      // Shirt buttons
      ctx.fillStyle = '#ffffff';
      for (let i = 0; i < 3; i++) {
        ctx.beginPath();
        ctx.arc(x, y + 18 + i * 6, 1.5, 0, Math.PI * 2);
        ctx.fill();
      }
      
      // Rolled sleeves detail
      ctx.fillStyle = '#3b82f6';
      ctx.fillRect(x - 15, y + 14, 30, 4);
      
      // Collar
      ctx.fillStyle = '#2563eb';
      ctx.beginPath();
      ctx.moveTo(x - 8, y + 14);
      ctx.lineTo(x - 12, y + 18);
      ctx.lineTo(x - 6, y + 20);
      ctx.lineTo(x, y + 16);
      ctx.closePath();
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(x + 8, y + 14);
      ctx.lineTo(x + 12, y + 18);
      ctx.lineTo(x + 6, y + 20);
      ctx.lineTo(x, y + 16);
      ctx.closePath();
      ctx.fill();
      
      // Head
      ctx.fillStyle = '#f5d0a9';
      ctx.beginPath();
      ctx.arc(x, y, 15, 0, Math.PI * 2);
