    const { useState, useEffect, useRef } = React;

// Mini-Game Component
const MiniGameComponent = ({ miniGame, onComplete, onCancel }) => {
  const [gameState, setGameState] = useState({
    input: '',
    score: 0,
    round: 1,
    timeLeft: 60,
    feedback: '',
    choices: []
  });

  // Generate choices based on game type
  useEffect(() => {
    if (miniGame.type === 'tagline') {
      generateTaglineChoices();
    } else if (miniGame.type === 'social') {
      generateSocialChoices();
    } else if (miniGame.type === 'pitch') {
      generatePitchChoices();
    }
  }, [miniGame.type]);

  // Timer
  useEffect(() => {
    const timer = setInterval(() => {
      setGameState(prev => {
        if (prev.timeLeft <= 0) {
          clearInterval(timer);
          onComplete(prev.score);
          return prev;
        }
        return { ...prev, timeLeft: prev.timeLeft - 1 };
      });
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const generateTaglineChoices = () => {
    const taglineOptions = [
      { text: 'Fresh beans, bold flavor', score: 85 },
      { text: 'Coffee that cares', score: 92 },
      { text: 'Brew good. Feel better.', score: 95 },
      { text: 'Just another coffee', score: 40 },
      { text: 'Sustainable sips for a better tomorrow', score: 88 }
    ];
    setGameState(prev => ({ ...prev, choices: taglineOptions }));
  };

  const generateSocialChoices = () => {
    const socialOptions = [
      { text: '✨ Innovation starts here #TechStart', score: 80 },
      { text: '🚀 Building the future, one line of code at a time', score: 92 },
      { text: '💡 Where great ideas become reality', score: 85 },
      { text: 'Check out our stuff', score: 30 },
      { text: '🔥 Disrupting industries. Creating possibilities. #StartupLife', score: 90 }
    ];
    setGameState(prev => ({ ...prev, choices: socialOptions }));
  };

  const generatePitchChoices = () => {
    const pitchOptions = [
      { text: 'Focus on sustainability and style', score: 88 },
      { text: 'Emphasize exclusivity and luxury craftsmanship', score: 95 },
      { text: 'Highlight affordability', score: 60 },
      { text: 'Appeal to eco-conscious millennials with bold designs', score: 92 },
      { text: 'Just talk about fashion', score: 35 }
    ];
    setGameState(prev => ({ ...prev, choices: pitchOptions }));
  };

  const handleChoice = (choice) => {
    const newScore = Math.min(100, gameState.score + choice.score);
    setGameState(prev => ({
      ...prev,
      score: newScore,
      feedback: choice.score >= 80 ? '✅ Excellent!' : choice.score >= 60 ? '👍 Good' : '❌ Could be better',
      choices: []
    }));

    setTimeout(() => {
      if (newScore >= 80) {
        onComplete(newScore);
      } else if (gameState.round < 2) {
        setGameState(prev => ({
          ...prev,
          round: prev.round + 1,
          feedback: ''
        }));
        if (miniGame.type === 'tagline') generateTaglineChoices();
        else if (miniGame.type === 'social') generateSocialChoices();
        else if (miniGame.type === 'pitch') generatePitchChoices();
      } else {
        onComplete(newScore);
      }
    }, 1500);
  };

  const getGameTitle = () => {
    if (miniGame.type === 'tagline') return '✍️ Tagline Challenge';
    if (miniGame.type === 'social') return '📱 Social Media Copy';
    if (miniGame.type === 'pitch') return '🎤 Client Pitch';
    if (miniGame.type === 'longform') return '📝 Brand Voice Guide';
    if (miniGame.type === 'speed') return '⚡ Speed Writing';
    return '🎮 Challenge';
  };

  const getGameInstructions = () => {
    if (miniGame.type === 'tagline') return 'Choose the best tagline for FreshBrew Coffee:';
    if (miniGame.type === 'social') return 'Pick the best Instagram caption for TechStart:';
    if (miniGame.type === 'pitch') return 'What angle should we pitch for this fashion brand?';
    return 'Complete the challenge:';
  };

  return (
    <div className="fixed inset-0 flex items-center justify-center p-4 z-50" style={{
      background: 'rgba(0, 0, 0, 0.9)',
      backdropFilter: 'blur(12px)'
    }}>
      <div className="rounded-xl p-8 max-w-2xl w-full" style={{
        background: '#ffffff',
        border: '4px solid #8b5cf6',
        boxShadow: '0 0 60px rgba(139, 92, 246, 0.5)'
      }}>
        {/* Header */}
        <div className="flex justify-between items-center mb-6">
          <h2 className="pixel-font text-lg" style={{ color: '#8b5cf6' }}>
            {getGameTitle()}
          </h2>
          <div className="pixel-font text-sm" style={{ color: '#6b7280' }}>
            ⏱️ {gameState.timeLeft}s
          </div>
        </div>

        {/* Score Bar */}
        <div className="mb-6">
          <div className="flex justify-between text-xs mb-2 pixel-font" style={{ color: '#1f2937' }}>
            <span>Score</span>
            <span>{gameState.score}/100</span>
          </div>
          <div style={{
            width: '100%',
            height: '12px',
            background: '#e5e7eb',
            borderRadius: '6px',
            overflow: 'hidden'
          }}>
            <div style={{
              width: `${gameState.score}%`,
              height: '100%',
              background: gameState.score >= 80 ? '#10b981' : gameState.score >= 60 ? '#f59e0b' : '#8b5cf6',
              transition: 'width 0.5s'
            }} />
          </div>
        </div>

        {/* Instructions */}
        <p className="pixel-font text-xs mb-6" style={{
          color: '#1f2937',
          lineHeight: '2'
        }}>
          {getGameInstructions()}
        </p>

        {/* Feedback */}
        {gameState.feedback && (
          <div className="mb-4 p-4 rounded-lg pixel-font text-xs text-center" style={{
            background: gameState.feedback.includes('✅') ? '#d1fae5' : gameState.feedback.includes('❌') ? '#fee2e2' : '#fef3c7',
            color: '#1f2937'
          }}>
            {gameState.feedback}
          </div>
        )}

        {/* Choices */}
        {gameState.choices.length > 0 && (
          <div className="flex flex-col gap-3 mb-6">
            {gameState.choices.map((choice, i) => (
              <button
                key={i}
                onClick={() => handleChoice(choice)}
                className="pixel-font text-xs px-6 py-4 rounded-lg text-left transition-all"
                style={{
                  background: '#f9fafb',
                  border: '3px solid #e5e7eb',
                  color: '#1f2937',
                  cursor: 'pointer'
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.background = '#8b5cf6';
                  e.currentTarget.style.color = '#ffffff';
                  e.currentTarget.style.borderColor = '#7c3aed';
                  e.currentTarget.style.transform = 'translateX(8px)';
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.background = '#f9fafb';
                  e.currentTarget.style.color = '#1f2937';
                  e.currentTarget.style.borderColor = '#e5e7eb';
                  e.currentTarget.style.transform = 'translateX(0)';
                }}
              >
                {choice.text}
              </button>
            ))}
          </div>
        )}

        {/* Cancel Button */}
        <button
          onClick={onCancel}
          className="pixel-font text-xs px-6 py-3 rounded"
          style={{
            background: '#6b7280',
            color: '#ffffff',
            border: '3px solid #4b5563',
            cursor: 'pointer'
          }}
        >
          ← Cancel
        </button>
      </div>
    </div>
  );
};

