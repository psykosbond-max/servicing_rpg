    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const currentRoom = rooms[gameState.currentRoom];

    // Draw floor
    ctx.fillStyle = currentRoom.floor;
    ctx.fillRect(0, 0, ROOM_WIDTH * TILE_SIZE, ROOM_HEIGHT * TILE_SIZE);

