    const moveInterval = setInterval(() => {
      setNpcPositions(prev => {
        const newPositions = { ...prev };
        const currentRoom = rooms[gameState.currentRoom];
        
        currentRoom.npcs.forEach(npc => {
          // Skip Sarah (receptionist) - she stays at desk
          if (npc.name === 'Sarah') return;
          
          const key = `${gameState.currentRoom}-${npc.name}`;
          const currentPos = newPositions[key] || { x: npc.x, y: npc.y };
          
          // 40% chance to move each tick
          if (Math.random() < 0.4) {
            // Random direction: up, down, left, right
            const directions = [
              { dx: 0, dy: -0.3 },  // up
              { dx: 0, dy: 0.3 },   // down
              { dx: -0.3, dy: 0 },  // left
              { dx: 0.3, dy: 0 }    // right
            ];
            
            // Pick random number of steps (2-3)
            const steps = Math.random() < 0.5 ? 2 : 3;
            const direction = directions[Math.floor(Math.random() * directions.length)];
            
            let newX = currentPos.x + (direction.dx * steps);
            let newY = currentPos.y + (direction.dy * steps);
            
            // Keep within wander bounds if defined
            if (npc.wanderArea) {
              newX = Math.max(npc.wanderArea.minX, Math.min(npc.wanderArea.maxX, newX));
              newY = Math.max(npc.wanderArea.minY, Math.min(npc.wanderArea.maxY, newY));
            } else {
              // Default bounds - stay within room
              newX = Math.max(1, Math.min(ROOM_WIDTH - 1, newX));
              newY = Math.max(2, Math.min(ROOM_HEIGHT - 1, newY));
            }
            
            // Special collision avoidance for Pete in break room (avoid table)
            if (npc.name === 'Pete' && newX > 7 && newX < 11 && newY > 5 && newY < 9) {
              return; // Don't update position if trying to walk through table
            }
            
            newPositions[key] = { x: newX, y: newY };
          }
        });
        
        return newPositions;
      });
    }, 2000); // Move every 2 seconds

