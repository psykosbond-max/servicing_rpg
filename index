  // Handle player movement
  const handleKeyDown = (e) => {
    
    // Handle dialogue navigation with arrow keys and space
    const currentDialogue = dialogueRef.current;
    if (currentDialogue && currentDialogue.options && currentDialogue.options.length > 0) {
      switch (e.key) {
        case 'ArrowUp':
        case 'w':
        case 'W':
          e.preventDefault();
          setSelectedDialogueOption(prev => {
            const newVal = prev > 0 ? prev - 1 : currentDialogue.options.length - 1;
            selectedOptionRef.current = newVal;
            return newVal;
          });
          return;
        case 'ArrowDown':
        case 's':
        case 'S':
          e.preventDefault();
          setSelectedDialogueOption(prev => {
            const newVal = prev < currentDialogue.options.length - 1 ? prev + 1 : 0;
            selectedOptionRef.current = newVal;
            return newVal;
          });
          return;
        case ' ':
        case 'Enter':
          e.preventDefault();
          // Execute the currently selected option using ref for reliability
          const selectedOption = currentDialogue.options[selectedOptionRef.current];
          if (selectedOption && selectedOption.action) {
            selectedOption.action();
          }
          return;
      }
      return; // Don't process movement when dialogue is open
    }
    
    if (!gameState.gameStarted || !gameState.characterSelected) return;

    const { x, y } = gameState.playerPosition;
    let newX = x;
    let newY = y;
    const speed = 0.3;

    switch (e.key) {
      case 'ArrowUp':
      case 'w':
      case 'W':
        newY = Math.max(0.5, y - speed);
        break;
      case 'ArrowDown':
      case 's':
      case 'S':
        newY = Math.min(ROOM_HEIGHT - 0.5, y + speed);
        break;
      case 'ArrowLeft':
      case 'a':
      case 'A':
        newX = Math.max(0.5, x - speed);
        break;
      case 'ArrowRight':
      case 'd':
      case 'D':
        newX = Math.min(ROOM_WIDTH - 0.5, x + speed);
        break;
      case ' ':
      case 'Enter':
        e.preventDefault();
        checkInteractions();
        return;
    }

    if (newX !== x || newY !== y) {
      playerPositionRef.current = { x: newX, y: newY };
      setGameState(prev => ({
        ...prev,
        playerPosition: { x: newX, y: newY },
        energy: Math.max(0, prev.energy - 0.3)
      }));
      
      // Check if player is near an exit
      checkExits(newX, newY);
    }
  };

  const checkExits = (x, y) => {
    const currentRoom = rooms[gameState.currentRoom];
    
    currentRoom.exits.forEach(exit => {
      // Check if player is anywhere within the exit area
      const isWithinX = x >= exit.x && x < exit.x + exit.width;
      const isWithinY = y >= exit.y && y < exit.y + exit.height;
      
      if (isWithinX && isWithinY) {
        changeRoom(exit.target);
      }
    });
  };

