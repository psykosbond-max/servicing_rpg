    playerPositionRef.current = { x: 8, y: 6 };
    setGameState(prev => ({
      ...prev,
      currentRoom: targetRoom,
      playerPosition: { x: 8, y: 6 } // Reset to center of new room
    }));
    showNotification(`Entered ${rooms[targetRoom].name}`);
